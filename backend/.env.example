# Ports: ForUs owns lane 10000. Local dev hits host-mapped ports; inside docker use service names.
DATABASE_URL=postgresql://forus:your_password@localhost:10010/forus
REDIS_URL=redis://localhost:10011
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=generate_with_openssl_rand_hex_32
PORT=10005

# Media storage — Cloudflare R2 (S3-compatible) for server-side uploads (/api/upload)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=forus-uploads
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Cloudinary — legacy client-direct upload signature route only; remove in Phase R5
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
