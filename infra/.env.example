# ForUs — Phase R backend environment (copy to infra/.env). Ports use the ForUs lane 10000.
# Firebase and MinIO are intentionally absent (removed 2026-07-27). Cloudinary removed at R5.

# ─── Django ─────────────────────────────────────────────────────────────────────
DEBUG=false
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins the Expo app / admin-web call from (empty = deny in prod).
ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# ─── PostgreSQL (schema owned by Django migrations) ─────────────────────────────
DB_NAME=forus
DB_USER=forus
DB_PASSWORD=forus
DB_HOST=postgres
DB_PORT=5432
# FastAPI reads the same DB via this URL (host = compose service name).
DATABASE_URL=postgresql://forus:forus@postgres:5432/forus

# ─── Redis (cache · Celery broker · WS pub/sub · rate limiting) ─────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Cloudflare R2 (media, S3-compatible, zero egress) — wired in R5 ────────────
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=forus-uploads
R2_PUBLIC_URL=https://<public-or-custom-domain>
MAX_UPLOAD_BYTES=52428800

# ─── Third-party (wired in later phases) ────────────────────────────────────────
# Pesapal (payments IPN → FastAPI, billing → Django) — R5 / Stillwater P5
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
# Agora (video tokens → FastAPI) — Stillwater P6
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Resend (transactional email → Django) — Stillwater P1/P2
RESEND_API_KEY=
# Expo push (notifications) — no key required for exp.host
